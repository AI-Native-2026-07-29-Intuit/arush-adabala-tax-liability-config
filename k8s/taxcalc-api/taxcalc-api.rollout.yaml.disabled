#   revisionHistoryLimit: 3
#   selector:
#     matchLabels:
#       app.kubernetes.io/name: taxcalc-api
#   strategy:
#     canary:
#       canaryService: taxcalc-api-canary
#       stableService: taxcalc-api
#       trafficRouting:
#         nginx:
#           stableIngress: taxcalc-api
#       steps:
#         - setWeight: 10
#         - pause: { duration: 2m }
#         - analysis:
#             templates:
#               - templateName: taxcalc-api-success-rate
#         - setWeight: 50
#         - pause: { duration: 5m }
#         - analysis:
#             templates:
#               - templateName: taxcalc-api-success-rate
#         - setWeight: 100
#   template:
#     metadata:
#       labels:
#         app.kubernetes.io/name: taxcalc-api
#     spec:
#       containers:
#         - name: taxcalc-api
#           image: uptimecrew/taxcalc-api:PLACEHOLDER
#           ports:
#             - { name: http, containerPort: 8080 }
#           envFrom:
#             - configMapRef: { name: taxcalc-api-config }
#             - secretRef: { name: taxcalc-api-secrets }
#           startupProbe:
#             httpGet: { path: /actuator/health/liveness, port: http }
#             failureThreshold: 30
#             periodSeconds: 5
#           livenessProbe:
